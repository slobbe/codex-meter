{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2023",
        "lib": ["ES2023"]
    },
    "include": ["src/**/*.js", "src/**/*.d.ts"],
    "exclude": ["dist", "node_modules"]
}
